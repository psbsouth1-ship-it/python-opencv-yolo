# YOLO 学习环境变量（由 VS Code 的 python.envFile 自动加载）
# 让 Ultralytics 的配置保存在项目文件夹内。
YOLO_CONFIG_DIR=${workspaceFolder}/.ultralytics
YOLO_VERBOSE=false
# 输出中文提示不乱码
PYTHONIOENCODING=utf-8

# 本机 Python 缺少中间 CA 证书，自动下载权重/数据集会报 CERTIFICATE_VERIFY_FAILED。
# 改用 certifi 自带的证书包（仍是正常 HTTPS 校验）。
SSL_CERT_FILE=${workspaceFolder}/.venv/Lib/site-packages/certifi/cacert.pem
